import "harness.cies";

func work(size) {
    var total = 0;
    for (var i = 0; i < size; i++) {
        var m = {};

        var k1 = "key-" + i;
        var k2 = "value-" + i;

        m[k1] = i;
        m[k2] = i + 1;

        total = total + m[k1];
        total = total + m[k2];
    }
    return total;
}

var size = 100000;
var expected = 10000000000;
if (harness.smoke()) {
    size = 1000;
    expected = 1000000;
}

harness.run("map_ops", work, size, expected);
