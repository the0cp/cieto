import "gc";
import "harness.cies";

gc.threshold(1024 * 1024);

class Node {
    Data;
    Next;
}

func makeChain(n) {
    var head = Node();
    var cur = head;

    for (var i = 0; i < n; i++) {
        var node = Node();
        node.Data = [i; 32];
        cur.Next = node;
        cur = node;
    }

    return cur.Data[0];
}

func work(size) {
    var total = 0;
    for (var round = 0; round < size; round++) {
        total = total + makeChain(200);
    }
    gc.collect();
    return total;
}

var size = 300;
var expected = 59700;
if (harness.smoke()) {
    size = 3;
    expected = 597;
}

harness.run("gc_churn", work, size, expected);
