import "assert.cies";
import "fs";
import "os";
import "path";
import "process";
import "time";

var cieto = os.getenv("CIETO_EXEC");
assert.ok(cieto != null, "test runner provides CIETO_EXEC");

var child = "process_child.cies";
if (!fs.exists(child)) {
    child = "tests/process_child.cies";
}

var childErr = "process_child_error.cies";
if (!fs.exists(childErr)) {
    childErr = "tests/process_child_error.cies";
}

var ok = process.run([
    cieto,
    child,
    "plain",
    "two words",
    "say\"hi",
    "tail\\",
    ""
]);

assert.eq(ok["code"], 0, "process.run success exit code");
assert.eq(ok["ok"], true, "process.run success ok flag");
assert.eq(ok["timedOut"], false, "process.run success timeout flag");
assert.ok(ok["stdout"].find("process child stdout") >= 0, "process.run captures stdout");
assert.eq(ok["stderr"], "", "process.run empty stderr on success");

var fail = process.run([cieto, childErr]);

assert.eq(fail["ok"], false, "process.run failure ok flag");
assert.eq(fail["timedOut"], false, "process.run failure timeout flag");
assert.ok(fail["code"] != 0, "process.run failure exit code");
assert.ok(fail["stderr"].find("Division by zero") >= 0, "process.run captures stderr");

var missing = process.run <| {
    "argv": ["cieto_missing_command_for_process_test_9d354d87"]
};

assert.eq(missing["ok"], false, "process.run missing command ok flag");
assert.eq(missing["code"], 127, "process.run missing command exit code");
assert.ok(missing["stderr"].find("process.run") >= 0, "process.run missing command stderr");

var optsChild = "process_fixture/process_child_opts.cies";
if (!fs.exists(optsChild)) {
    optsChild = "tests/process_fixture/process_child_opts.cies";
}
optsChild = path.abs(optsChild);

var parentEnv = os.getenv("CIETO_PROCESS_TEST_ENV");
var withOpts = process.run <| {
    argv = [cieto, optsChild],
    cwd = path.dirname(optsChild),
    env = {
        CIETO_EXEC = "child override",
        CIETO_PROCESS_TEST_ENV = "child value with spaces"
    }
};

assert.eq(withOpts["code"], 0, "process.run cwd and env exit code");
assert.eq(withOpts["ok"], true, "process.run cwd and env ok flag");
assert.ok(withOpts["stdout"].find("process child opts") >= 0, "process.run applies cwd and env");
assert.eq(os.getenv("CIETO_PROCESS_TEST_ENV"), parentEnv, "process.run does not change parent env");
assert.eq(os.getenv("CIETO_EXEC"), cieto, "process.run keeps parent env overrides local");

var badCwd = process.run([cieto, optsChild], {
    "cwd": path.join(path.dirname(optsChild), "missing_process_cwd_9d354d87")
});

assert.eq(badCwd["code"], 127, "process.run missing cwd exit code");
assert.eq(badCwd["ok"], false, "process.run missing cwd ok flag");

var timeoutChild = "process_child_timeout.cies";
if (!fs.exists(timeoutChild)) {
    timeoutChild = "tests/process_child_timeout.cies";
}
timeoutChild = path.abs(timeoutChild);

var sleepChild = "process_child_sleep.cies";
if (!fs.exists(sleepChild)) {
    sleepChild = "tests/process_child_sleep.cies";
}
sleepChild = path.abs(sleepChild);

var timeoutStart = time.steady();
var timedOut = process.run <| {
    argv = [cieto, timeoutChild, sleepChild],
    timeout = 0.1
};
var timeoutElapsed = time.steady() - timeoutStart;

assert.eq(timedOut["code"], null, "process.run timeout has no exit code");
assert.eq(timedOut["ok"], false, "process.run timeout ok flag");
assert.eq(timedOut["timedOut"], true, "process.run timeout flag");
assert.ok(timeoutElapsed < 5, "process.run returns promptly after timeout");

var invalidChild = "process_child_invalid_opts.cies";
if (!fs.exists(invalidChild)) {
    invalidChild = "tests/process_child_invalid_opts.cies";
}
invalidChild = path.abs(invalidChild);

var optErrs = [
    ["opts_type", "opts must be a Map"],
    ["argv_missing", "config requires argv"],
    ["argv_type", "argv must be a List"],
    ["argv_duplicate", "argv must not be specified twice"],
    ["unknown", "unknown option"],
    ["cwd_type", "cwd must be a string"],
    ["cwd_null", "cwd must not contain null bytes"],
    ["env_type", "env must be a Map"],
    ["env_name", "env names must be strings"],
    ["env_value", "env values must be strings"],
    ["env_null", "env must not contain null bytes"],
    ["timeout_type", "timeout must be a number"],
    ["timeout_zero", "timeout must be finite and greater than zero"],
    ["timeout_negative", "timeout must be finite and greater than zero"],
    ["timeout_infinite", "timeout must be finite and greater than zero"],
    ["timeout_large", "timeout is too large"]
];

for (var optErr : optErrs) {
    var result = process.run([cieto, invalidChild, optErr[0]]);
    assert.eq(result["ok"], false, "process.run rejects " + optErr[0]);
    assert.ok(result["stderr"].find(optErr[1]) >= 0, "process.run reports " + optErr[0]);
}
