import "harness.cies";

func add3(a, b, c) {
    return a + b + c;
}

func mix(x) {
    var a = add3(x, 1, 2);
    var b = add3(a, 3, 4);
    var c = add3(b, 5, 6);
    return c % 1000003;
}

func work(size) {
    var total = 0;
    for (var i = 0; i < size; i++) {
        total = total + mix(i);
    }
    return total;
}

var size = 1000000;
var expected = 500002499946;
if (harness.smoke()) {
    size = 1000;
    expected = 520500;
}

harness.run("function_calls", work, size, expected);
