import "assert.cies";

# List Operations
var list = [1, 2];
list.push(3);

assert.eq(list.size(), 3, "List size after push");
assert.eq(list.pop(), 3, "List pop returns last element");
assert.eq(list.size(), 2, "List size after pop");

var push = list.push;
push(4);
assert.eq(list.pop(), 4, "Captured list method keeps its receiver");

var nested = [];
nested.push("abc".len());
assert.eq(nested[0], 3, "Nested direct method calls preserve prepared call state");

func nestedLength() { return "frame".len(); }
nested.push(nestedLength());
assert.eq(nested[1], 5, "Prepared calls survive nested script frames");

# List Bulk Fill
var filled = [0; 5];
assert.eq(filled.size(), 5, "List bulk initialization size");
assert.eq(filled[4], 0, "List bulk initialization value");

# Map Operations
var dict = { 
    "a": 1, 
    10: "ten" 
};

assert.eq(dict["a"], 1, "Map string key access");
assert.eq(dict[10], "ten", "Map integer key access");

dict["new"] = 99;
assert.eq(dict["new"], 99, "Map value assignment");

dict["a"] = 2;
assert.eq(dict["a"], 2, "Map existing key update");

dict[true] = "yes";
assert.eq(dict[true], "yes", "Map bool key access");

dict[null] = "nil";
assert.eq(dict[null], "nil", "Map null key access");

var dynamicKey = "dynamic";
var staticKey = "not-static";
var fields = {
    staticKey = 7,
    "quoted": 8,
    dynamicKey: 9
};
assert.eq(fields["staticKey"], 7, "Map static field key");
assert.eq(fields["quoted"], 8, "Map quoted string key with static fields");
assert.eq(fields["dynamic"], 9, "Map dynamic key with static fields");

# Iteration
var iterSum = 0;
for (var n : [1, 2, 3]) { 
    iterSum += n; 
}
assert.eq(iterSum, 6, "Foreach iteration over list");

var nullListCount = 0;
for (var item : [null]) {
    if (item == null) nullListCount++;
}
assert.eq(nullListCount, 1, "List foreach preserves a null item");

var emptyMapCount = 0;
for (var key : {}) emptyMapCount++;
assert.eq(emptyMapCount, 0, "Empty Map foreach yields no entries");

var singleKeyMap = {"only": 1};
var singleKeyCount = 0;
var sawOnlyKey = false;
for (var key : singleKeyMap) {
    singleKeyCount++;
    if (key == "only") sawOnlyKey = true;
}
assert.eq(singleKeyCount, 1, "Map foreach visits only occupied entries");
assert.ok(sawOnlyKey, "Map foreach yields the stored key");

var nullKeyMap = {null: 7};
var nullKeyCount = 0;
var sawNullKey = false;
for (var key : nullKeyMap) {
    nullKeyCount++;
    if (key == null) sawNullKey = true;
}
assert.eq(nullKeyCount, 1, "Map foreach visits a null key once");
assert.ok(sawNullKey, "Map foreach preserves a null key");

var nullIterator = iter([null]);
assert.eq(nullIterator.advance(), true, "Iterator advances to a null item");
assert.eq(nullIterator.current(), null, "Iterator current preserves a null item");
assert.eq(nullIterator.advance(), false, "Iterator reports completion separately");

var nullMapIterator = iter({null: 7});
assert.eq(nullMapIterator.advance(), true, "Iterator advances to a null Map key");
assert.eq(nullMapIterator.current(), null, "Iterator current preserves a null Map key");
assert.eq(nullMapIterator.advance(), false, "Null-key Map iterator completes");

var stringIterator = iter("ab");
assert.eq(stringIterator.advance(), true, "Manual string iterator advances to first item");
assert.eq(stringIterator.current(), "a", "Manual string iterator first item");
assert.eq(stringIterator.advance(), true, "Manual string iterator advances to second item");
assert.eq(stringIterator.current(), "b", "Manual string iterator second item");
assert.eq(stringIterator.advance(), false, "Manual string iterator completion");
