import "assert.cies";
import "gc";

func testConcatenation() {
    var left = "left";
    var alias = left;
    var result = left + "right";

    assert.eq(result, "leftright", "String concatenation");
    assert.eq(left, "left", "String concatenation keeps the left operand immutable");
    assert.eq(alias, "left", "String concatenation keeps aliases unchanged");
    assert.eq("value=" + 42, "value=42", "String concatenation converts the right operand");
    assert.eq(42 + "!", "42!", "String concatenation converts the left operand");
    assert.eq("" + "", "", "String concatenation handles empty operands");

    var values = {};
    values[result] = 7;
    assert.eq(values["leftright"], 7, "Concatenated strings retain a valid hash");

    var oldThreshold = gc.threshold();
    var growing = "";
    for (var i = 0; i < 64; i++) {
        gc.threshold(0);
        growing = growing + "x";
    }
    gc.threshold(oldThreshold);
    assert.eq(growing.len(), 64, "String concatenation remains valid across collections");
}

func testInterpolation() {
    var name = "Cieto";
    var msg = "Hello, ${name}!";
    assert.eq(msg, "Hello, Cieto!", "String interpolation");
    assert.eq("${name}", "Cieto", "Single-value string interpolation");

    var trace = "";
    func record(value) {
        trace = trace + value;
        return value;
    }

    var ordered = "${record(1)}${record(2)}${record(3)}";
    assert.eq(ordered, "123", "String interpolation joins multiple values");
    assert.eq(trace, "123", "String interpolation preserves evaluation order");

    var values = {};
    var key = "key-${name}-${42}-${true}";
    values[key] = 9;
    assert.eq(values["key-Cieto-42-true"], 9, "Interpolated strings retain a valid hash");

    var tail = "tail";
    var oldThreshold = gc.threshold();
    func armGc(value) {
        gc.threshold(0);
        return value;
    }
    var collected = "a${name}b${armGc(tail)}";
    gc.threshold(oldThreshold);
    assert.eq(collected, "aCietobtail", "String interpolation remains valid across collection");
}

func testStringBuilder() {
    var builder = StringBuilder();
    assert.eq(builder.len(), 0, "String builder starts empty");
    assert.eq(builder.string(), "", "Empty string builder creates an empty string");

    var chained = builder.append("hello", " ").append("world");
    assert.eq(chained, builder, "String builder append returns the receiver");
    assert.eq(builder.len(), 11, "String builder tracks its length");
    assert.eq(builder.string(), "hello world", "String builder joins appended strings");

    builder.append("");
    builder.append();
    assert.eq(builder.string(), "hello world", "String builder ignores empty parts");

    var snapshot = builder.string();
    builder.append("!");
    assert.eq(snapshot, "hello world", "String builder keeps completed strings immutable");
    assert.eq(builder.string(), "hello world!", "String builder remains reusable");

    var oldThreshold = gc.threshold();
    var growing = StringBuilder();
    for (var i = 0; i < 128; i++) {
        gc.threshold(0);
        growing.append("ab");
    }
    gc.threshold(0);
    var collected = growing.string();
    gc.threshold(oldThreshold);
    assert.eq(growing.len(), 256, "String builder survives collection while growing");
    assert.eq(collected.len(), 256, "String builder creates a string during collection");

    var values = {};
    values[collected] = 7;
    assert.eq(values[growing.string()], 7, "String builder output retains a valid hash");
}

func testIndexingAndSlicing() {
    var s = "abcdef";
    assert.eq(s[0], "a", "String positive index");
    assert.eq(s[-1], "f", "String negative index");

    var slice1 = s[1:4];
    assert.eq(slice1, "bcd", "Basic slicing");

    var slice2 = s[::-1];
    assert.eq(slice2, "fedcba", "Reverse slicing with negative step");
}

func testCaseAndTrim() {
    var text = "  Hello World  ";
    assert.eq(text.len(), 15, "String len");
    assert.eq(text.trim(), "Hello World", "String trim");
    assert.eq(text.trim().upper(), "HELLO WORLD", "Method chaining trim and upper");
    assert.eq("HELLO".lower(), "hello", "String lower");
    assert.eq("".trim(), "", "Trim empty string");
    assert.eq("     ".trim(), "", "Trim whitespace-only string");
}

func testSub() {
    assert.eq("abcdef".sub(1), "bcdef", "String sub from start");
    assert.eq("abcdef".sub(1, 4), "bcd", "String sub with end");
    assert.eq("abcdef".sub(-3), "def", "String sub negative start");
    assert.eq("abcdef".sub(1, -1), "bcde", "String sub negative end");
    assert.eq("abcdef".sub(4, 2), "", "String sub invalid range returns empty string");
    assert.eq("abcdef".sub(-100, 2), "ab", "String sub clamps start");
    assert.eq("abcdef".sub(4, 100), "ef", "String sub clamps end");
}

func testFind() {
    assert.eq("hello world".find("world"), 6, "String find existing substring");
    assert.eq("hello world".find("x"), -1, "String find missing substring");
    assert.eq("hello".find(""), 0, "String find empty substring");
}

func testSplit() {
    var parts = "a,b,c".split(",");
    assert.eq(parts.size(), 3, "Split size");
    assert.eq(parts[0], "a", "Split first content");
    assert.eq(parts[1], "b", "Split middle content");
    assert.eq(parts[2], "c", "Split last content");

    var edgeParts = "a,,c,".split(",");
    assert.eq(edgeParts.size(), 4, "Split keeps empty segments");
    assert.eq(edgeParts[1], "", "Split empty middle segment");
    assert.eq(edgeParts[3], "", "Split empty trailing segment");

    var chars = "abc".split("");
    assert.eq(chars.size(), 3, "Split empty delimiter size");
    assert.eq(chars[0], "a", "Split empty delimiter first char");
    assert.eq(chars[2], "c", "Split empty delimiter last char");
}

func testReplace() {
    assert.eq("banana".replace("na", "NA"), "baNANA", "String replace repeated substring");
    assert.eq("hello".replace("x", "y"), "hello", "String replace missing substring keeps original value");
    assert.eq("hello".replace("", "x"), "hello", "String replace empty old string keeps original value");
    assert.eq("aaaa".replace("aa", "b"), "bb", "String replace non-overlapping matches");
}

testConcatenation();
testInterpolation();
testStringBuilder();
testIndexingAndSlicing();
testCaseAndTrim();
testSub();
testFind();
testSplit();
testReplace();
