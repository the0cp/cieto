import "harness.cies";

class Counter {
    value = 0;
}

method (c Counter) init(v) {
    c.value = v;
}

method (c Counter) inc(x) {
    c.value = c.value + x;
    return c.value;
}

method (c Counter) get() {
    return c.value;
}

func work(size) {
    var total = 0;
    for (var i = 0; i < size; i++) {
        var c = Counter(i);

        total = total + c.inc(1);
        total = total + c.inc(2);
        total = total + c.get();
    }
    return total;
}

var size = 500000;
var expected = 375002750000;
if (harness.smoke()) {
    size = 1000;
    expected = 1505500;
}

harness.run("object_dispatch", work, size, expected);
